{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quire Session Protocol",
  "type": "object",
  "properties": {
    "attachment_meta": {
      "$ref": "#/$defs/AttachmentMeta"
    },
    "create_session_request": {
      "$ref": "#/$defs/CreateSessionRequest"
    },
    "pending_question": {
      "$ref": "#/$defs/PendingQuestion"
    },
    "question_answer": {
      "$ref": "#/$defs/QuestionAnswer"
    },
    "question_item": {
      "$ref": "#/$defs/QuestionItem"
    },
    "question_option": {
      "$ref": "#/$defs/QuestionOption"
    },
    "run_trace_summary": {
      "$ref": "#/$defs/RunTraceSummary"
    },
    "send_message_request": {
      "$ref": "#/$defs/SendMessageRequest"
    },
    "session_detail": {
      "$ref": "#/$defs/SessionDetail"
    },
    "session_event": {
      "$ref": "#/$defs/SessionEvent"
    },
    "session_message": {
      "$ref": "#/$defs/SessionMessage"
    },
    "session_summary": {
      "$ref": "#/$defs/SessionSummary"
    },
    "tool_call_detail": {
      "$ref": "#/$defs/ToolCallDetail"
    }
  },
  "required": [
    "session_event",
    "session_summary",
    "session_detail",
    "session_message",
    "attachment_meta",
    "create_session_request",
    "send_message_request",
    "tool_call_detail",
    "question_option",
    "question_item",
    "question_answer",
    "pending_question",
    "run_trace_summary"
  ],
  "$defs": {
    "ActiveRunStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "interrupted",
        "failed",
        "awaiting_input"
      ]
    },
    "AttachmentMeta": {
      "type": "object",
      "properties": {
        "attachment_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "mime_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "attachment_id",
        "filename",
        "mime_type",
        "size_bytes"
      ]
    },
    "ContextUsage": {
      "type": "object",
      "properties": {
        "cached_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_limit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_used": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "context_used",
        "context_limit"
      ]
    },
    "CreateSessionRequest": {
      "type": "object",
      "properties": {
        "doc_id": {
          "description": "Optional existing report to bind immediately.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "kb_branch": {
          "description": "Test a draft knowledge-base branch. Omit to use the current active branch.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "MessageRole": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool",
        "system",
        "compaction"
      ]
    },
    "PendingQuestion": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "question_id": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionItem"
          }
        },
        "run_id": {
          "type": "string"
        },
        "tool_call_id": {
          "description": "The `ask_user` tool call that opened this question, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "question_id",
        "run_id",
        "questions",
        "created_at"
      ]
    },
    "PendingQueueItem": {
      "description": "One message waiting for the session's active run to finish.",
      "type": "object",
      "properties": {
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "queue_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PendingQueueSource"
        },
        "thread_id": {
          "description": "Comment thread that produced this item, when `source` is `comment`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "queue_id",
        "session_id",
        "content",
        "source",
        "created_at"
      ]
    },
    "PendingQueueSource": {
      "description": "Why a message is waiting in the per-session queue.",
      "type": "string",
      "enum": [
        "user",
        "comment"
      ]
    },
    "QuestionAnswer": {
      "type": "object",
      "properties": {
        "freeform_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "question_id": {
          "type": "string"
        },
        "selected_option_ids": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "question_id"
      ]
    },
    "QuestionItem": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/QuestionOption"
          }
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ]
    },
    "QuestionOption": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "ResolvedQuestion": {
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/QuestionAnswer"
          }
        },
        "question": {
          "$ref": "#/$defs/PendingQuestion"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "status"
      ]
    },
    "RunTaskFocus": {
      "type": "object",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ]
    },
    "RunTraceSegment": {
      "description": "One ordered slice of a run. Text output closes the preceding thinking and\nexecution phase, so later reasoning or tools start a new segment instead of\nbeing folded back into an older block.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "thinking"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "execution"
            },
            "subagents": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/RunTraceSubagent"
              }
            },
            "tools": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/RunTraceToolItem"
              }
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
    "RunTraceSubagent": {
      "type": "object",
      "properties": {
        "agent_name": {
          "type": "string"
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "subagent_run_id": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": "string"
        },
        "task_focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunTaskFocus"
            },
            {
              "type": "null"
            }
          ]
        },
        "thinking": {
          "type": "string"
        },
        "thinking_duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tools": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunTraceToolItem"
          }
        }
      },
      "required": [
        "subagent_run_id",
        "agent_name",
        "task",
        "status",
        "thinking"
      ]
    },
    "RunTraceSummary": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "segments": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/RunTraceSegment"
          }
        },
        "status": {
          "type": "string"
        },
        "task_focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunTaskFocus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "status"
      ]
    },
    "RunTraceToolItem": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_preview": {
          "type": "string"
        },
        "output_preview": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "tool_call_id",
        "tool_name",
        "status",
        "input_preview"
      ]
    },
    "SendMessageRequest": {
      "type": "object",
      "properties": {
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "client_msg_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "client_msg_id",
        "content"
      ]
    },
    "SessionDetail": {
      "type": "object",
      "properties": {
        "active_run_status": {
          "$ref": "#/$defs/ActiveRunStatus"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachmentMeta"
          }
        },
        "compacted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "compacting": {
          "type": "boolean",
          "default": false
        },
        "context_usage": {
          "$ref": "#/$defs/ContextUsage",
          "default": {
            "cached_tokens": 0,
            "context_limit": 0,
            "context_used": 0,
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "doc_id": {
          "description": "Quire report bound to this session. `None` until the first run auto-binds.",
          "type": [
            "string",
            "null"
          ]
        },
        "kb_branch": {
          "description": "Knowledge-base branch used by this session. `None` only for sessions created before\nbranch-scoped knowledge bases existed; those fall back to the current active branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_event_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "linked_doc_id": {
          "description": "Frontend-friendly alias of the bound report ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionMessage"
          }
        },
        "pending_question": {
          "description": "Latest unresolved question card, restored after refresh or reconnect.",
          "anyOf": [
            {
              "$ref": "#/$defs/PendingQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_queue": {
          "description": "Messages waiting for the current run to finish, in FIFO order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingQueueItem"
          }
        },
        "pinned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "resolved_questions": {
          "description": "Answered, skipped and dismissed question cards in creation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedQuestion"
          }
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "session_id",
        "title",
        "status",
        "active_run_status",
        "last_event_seq",
        "created_at",
        "updated_at"
      ]
    },
    "SessionEvent": {
      "description": "Common envelope for every Session-SSE frame.",
      "type": "object",
      "properties": {
        "agent_id": {
          "description": "`\"main\"` or a stable subagent identifier.",
          "type": "string"
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_started"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_finished"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "turn_failed"
            },
            "recoverable": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "error",
            "recoverable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "sync_required"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "after_seq",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "thinking_delta"
            }
          },
          "required": [
            "event",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "delta": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "text_delta"
            }
          },
          "required": [
            "event",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "task_focus"
            },
            "section_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "tool_call_started"
            },
            "input_preview": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "tool_call_id",
            "tool_name",
            "input_preview",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "tool_call_finished"
            },
            "output_preview": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "tool_call_id": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "tool_call_id",
            "status",
            "output_preview",
            "truncated",
            "duration_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_name": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "event": {
              "type": "string",
              "const": "subagent_started"
            },
            "section_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "subagent_run_id": {
              "type": "string"
            },
            "task": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "subagent_run_id",
            "agent_name",
            "task"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "subagent_finished"
            },
            "status": {
              "type": "string"
            },
            "subagent_run_id": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "subagent_run_id",
            "status",
            "summary"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cached_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "context_limit": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "context_used": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "event": {
              "type": "string",
              "const": "context_usage"
            },
            "input_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "input_tokens",
            "output_tokens",
            "cached_tokens",
            "context_used",
            "context_limit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "questionnaire_requested"
            },
            "question_id": {
              "type": "string"
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuestionItem"
              }
            },
            "tool_call_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "event",
            "question_id",
            "questions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuestionAnswer"
              }
            },
            "event": {
              "type": "string",
              "const": "questionnaire_answered"
            },
            "question_id": {
              "type": "string"
            },
            "skipped_all": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "question_id",
            "answers",
            "skipped_all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "questionnaire_dismissed"
            },
            "question_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "question_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "doc_id": {
              "type": "string"
            },
            "event": {
              "type": "string",
              "const": "doc_linked"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "doc_id",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "session_title_updated"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "user_message_added"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "message_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "pending_queue_updated"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PendingQueueItem"
              }
            }
          },
          "required": [
            "event",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "compaction_started"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "compaction_finished"
            },
            "success": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "success"
          ]
        }
      ],
      "required": [
        "seq",
        "run_id",
        "agent_id",
        "timestamp"
      ]
    },
    "SessionMessage": {
      "type": "object",
      "properties": {
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "message_id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/MessageRole"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "session_id",
        "role",
        "content",
        "created_at"
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "SessionSummary": {
      "type": "object",
      "properties": {
        "active_run_status": {
          "$ref": "#/$defs/ActiveRunStatus"
        },
        "compacted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "compacting": {
          "type": "boolean",
          "default": false
        },
        "context_usage": {
          "$ref": "#/$defs/ContextUsage",
          "default": {
            "cached_tokens": 0,
            "context_limit": 0,
            "context_used": 0,
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "doc_id": {
          "description": "Quire report bound to this session. `None` until the first run auto-binds.",
          "type": [
            "string",
            "null"
          ]
        },
        "kb_branch": {
          "description": "Knowledge-base branch used by this session. `None` only for sessions created before\nbranch-scoped knowledge bases existed; those fall back to the current active branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "last_event_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "linked_doc_id": {
          "description": "Frontend-friendly alias of the bound report ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "pinned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "session_id",
        "title",
        "status",
        "active_run_status",
        "last_event_seq",
        "created_at",
        "updated_at"
      ]
    },
    "ToolCallDetail": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "default": null
        },
        "output": {
          "default": null
        },
        "run_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        }
      },
      "required": [
        "tool_call_id",
        "session_id",
        "run_id",
        "tool_name",
        "status",
        "duration_ms",
        "created_at"
      ]
    }
  }
}
