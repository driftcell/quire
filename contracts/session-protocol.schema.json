    "RunTraceSegment": {
      "description": "One ordered slice of a run. Text output closes the preceding thinking and\nexecution phase, so later reasoning or tools start a new segment instead of\nbeing folded back into an older block.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "thinking"
            },
            "text": {
              "type": "string"
            },
            "duration_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "started_at": {
              "description": "Server timestamp when this thinking phase started. Retained while the\nphase is still streaming so clients can continue the timer after refresh.",
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "text"
          ]
