            "subagents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RunTraceSubagent"
              },
              "default": []
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        }
      ]
    },
