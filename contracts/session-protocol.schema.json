{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quire Session Protocol",
  "type": "object",
  "properties": {
    "session_event": {
      "$ref": "#/$defs/SessionEvent"
    },
    "session_summary": {
      "$ref": "#/$defs/SessionSummary"
    },
    "session_detail": {
      "$ref": "#/$defs/SessionDetail"
    },
    "session_message": {
      "$ref": "#/$defs/SessionMessage"
    },
    "attachment_meta": {
      "$ref": "#/$defs/AttachmentMeta"
    },
    "create_session_request": {
      "$ref": "#/$defs/CreateSessionRequest"
    },
    "send_message_request": {
      "$ref": "#/$defs/SendMessageRequest"
    },
    "update_pending_message_request": {
      "$ref": "#/$defs/UpdatePendingMessageRequest"
    },
    "tool_call_detail": {
      "$ref": "#/$defs/ToolCallDetail"
    },
    "question_option": {
      "$ref": "#/$defs/QuestionOption"
    },
    "question_item": {
      "$ref": "#/$defs/QuestionItem"
    },
    "question_answer": {
      "$ref": "#/$defs/QuestionAnswer"
    },
    "pending_question": {
      "$ref": "#/$defs/PendingQuestion"
    },
    "ask_user_answer_payload": {
      "$ref": "#/$defs/AskUserAnswerPayload"
    },
    "questionnaire_resolution_status": {
      "$ref": "#/$defs/QuestionnaireResolutionStatus"
    },
    "resolved_question_item_answer": {
      "$ref": "#/$defs/ResolvedQuestionItemAnswer"
    },
    "run_trace_summary": {
      "$ref": "#/$defs/RunTraceSummary"
    }
  },
  "required": [
    "session_event",
    "session_summary",
    "session_detail",
    "session_message",
    "attachment_meta",
    "create_session_request",
    "send_message_request",
    "update_pending_message_request",
    "tool_call_detail",
    "question_option",
    "question_item",
    "question_answer",
    "pending_question",
    "ask_user_answer_payload",
    "questionnaire_resolution_status",
    "resolved_question_item_answer",
    "run_trace_summary"
  ],
  "$defs": {
    "SessionEvent": {
      "description": "Common envelope for every Session-SSE frame.",
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        },
        "agent_id": {
          "description": "`\"main\"` or a stable subagent identifier.",
          "type": "string"
        },
        "parent_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "seq",
        "run_id",
        "agent_id",
        "timestamp"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_started"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_finished"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_superseded"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "turn_failed"
            },
            "error": {
              "type": "string"
            },
            "recoverable": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "error",
            "recoverable"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "sync_required"
            },
            "after_seq": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "after_seq",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "thinking_delta"
            },
            "delta": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "text_delta"
            },
            "delta": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "delta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "task_focus"
            },
            "title": {
              "type": "string"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            },
            "section_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "todos": {
              "description": "Retained only for legacy `task_focus` replay payloads; live checklist mutations arrive\nthrough [`SessionEventKind::TodosUpdated`].",
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskTodoItem"
              }
            }
          },
          "required": [
            "event",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "todos_updated"
            },
            "todos": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskTodoItem"
              }
            }
          },
          "required": [
            "event",
            "todos"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "tool_call_started"
            },
            "tool_call_id": {
              "type": "string"
            },
            "tool_name": {
              "type": "string"
            },
            "input_preview": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "tool_call_id",
            "tool_name",
            "input_preview",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "tool_call_finished"
            },
            "tool_call_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "output_preview": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "duration_ms": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "event",
            "tool_call_id",
            "status",
            "output_preview",
            "truncated",
            "duration_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "subagent_started"
            },
            "subagent_run_id": {
              "type": "string"
            },
            "agent_name": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "task": {
              "type": "string"
            },
            "section_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "event",
            "subagent_run_id",
            "agent_name",
            "task"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "subagent_finished"
            },
            "subagent_run_id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "subagent_run_id",
            "status",
            "summary"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "context_usage"
            },
            "input_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "cached_tokens": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "context_used": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "context_limit": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "cost_rmb": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "output_price_rmb": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "required": [
            "event",
            "input_tokens",
            "output_tokens",
            "cached_tokens",
            "context_used",
            "context_limit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "questionnaire_requested"
            },
            "question_id": {
              "type": "string"
            },
            "tool_call_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuestionItem"
              }
            }
          },
          "required": [
            "event",
            "question_id",
            "questions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "questionnaire_answered"
            },
            "question_id": {
              "type": "string"
            },
            "answers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/QuestionAnswer"
              }
            },
            "skipped_all": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "question_id",
            "answers",
            "skipped_all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "questionnaire_dismissed"
            },
            "question_id": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "question_id",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "doc_linked"
            },
            "doc_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "doc_id",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "session_title_updated"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "user_message_added"
            },
            "message_id": {
              "type": "string"
            }
          },
          "required": [
            "event",
            "message_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "pending_queue_updated"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PendingQueueItem"
              }
            }
          },
          "required": [
            "event",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "compaction_started"
            }
          },
          "required": [
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string",
              "const": "compaction_finished"
            },
            "success": {
              "type": "boolean"
            }
          },
          "required": [
            "event",
            "success"
          ]
        }
      ]
    },
    "TaskTodoItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskTodoStatus"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "status"
      ]
    },
    "TaskTodoStatus": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "skipped"
      ]
    },
    "QuestionItem": {
      "description": "One structured question card rendered by `ask_user` (`1..=4` questions per call).",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable short identifier for this question (e.g. `\"report_scope\"` or `\"target_length\"`).",
          "type": "string"
        },
        "title": {
          "description": "Direct, concise question prompt shown to the user.",
          "type": "string"
        },
        "description": {
          "description": "Optional brief context explaining why this decision matters for the report.",
          "type": [
            "string",
            "null"
          ]
        },
        "multiple": {
          "description": "Allow selecting multiple options (`true`) or enforce single-choice (`false`, default).",
          "type": "boolean",
          "default": false
        },
        "required": {
          "description": "Whether the user must answer this question before submitting (`false` by default).",
          "type": "boolean",
          "default": false
        },
        "options": {
          "description": "Concrete selectable options (2–4 distinct choices recommended; the UI automatically provides a freeform custom text input alongside these options, so do not add a blank `\"Other\"` option).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ]
    },
    "QuestionOption": {
      "description": "One selectable option inside an `ask_user` `QuestionItem`.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable short identifier for this option within the question (e.g. `\"opt_exec\"` or `\"30k\"`).",
          "type": "string"
        },
        "label": {
          "description": "Concise user-facing option label (put your recommended choice first and suffix it with `\"(Recommended)\"` / `\"（推荐）\"`).",
          "type": "string"
        },
        "description": {
          "description": "Optional 1-sentence explanation of the trade-off or implication of choosing this option.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "QuestionAnswer": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string"
        },
        "selected_option_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "freeform_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "skipped": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "question_id"
      ]
    },
    "PendingQueueItem": {
      "description": "One message waiting for the session's active run to finish.",
      "type": "object",
      "properties": {
        "queue_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "comment_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionCommentRef"
          }
        },
        "source": {
          "$ref": "#/$defs/PendingQueueSource"
        },
        "thread_id": {
          "description": "Comment thread that produced this item, when `source` is `comment`.",
          "type": [
            "string",
            "null"
          ]
        },
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "queue_id",
        "session_id",
        "content",
        "source",
        "created_at"
      ]
    },
    "SessionCommentRef": {
      "description": "Immutable send-time snapshot of a report comment handed to the agent.",
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string"
        },
        "block_id": {
          "type": "string"
        },
        "end_block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "end_quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "thread_id",
        "block_id",
        "status",
        "comment"
      ]
    },
    "PendingQueueSource": {
      "description": "Why a message is waiting in the per-session queue.",
      "type": "string",
      "enum": [
        "user",
        "comment"
      ]
    },
    "SessionSummary": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "user_id": {
          "description": "Owning SaaS user ID (`None` for legacy/system sessions).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "doc_id": {
          "description": "Quire report bound to this session. `None` until the first run auto-binds.",
          "type": [
            "string",
            "null"
          ]
        },
        "linked_doc_id": {
          "description": "Frontend-friendly alias of the bound report ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "kb_branch": {
          "description": "Knowledge-base branch used by this session. `None` only for sessions created before\nbranch-scoped knowledge bases existed; those fall back to the current active branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "active_run_status": {
          "$ref": "#/$defs/ActiveRunStatus"
        },
        "last_event_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_usage": {
          "$ref": "#/$defs/ContextUsage",
          "default": {
            "input_tokens": 0,
            "output_tokens": 0,
            "cached_tokens": 0,
            "context_used": 0,
            "context_limit": 0
          }
        },
        "compacting": {
          "type": "boolean",
          "default": false
        },
        "compacted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pinned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "session_id",
        "title",
        "status",
        "active_run_status",
        "last_event_seq",
        "created_at",
        "updated_at"
      ]
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ]
    },
    "ActiveRunStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "interrupted",
        "failed",
        "awaiting_input"
      ]
    },
    "ContextUsage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cached_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_used": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_limit": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cost_rmb": {
          "description": "Cumulative session cost in RMB (CNY) across main agent, subagents, and compaction.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "output_price_rmb": {
          "description": "Output token price in RMB (CNY) per 1,000,000 tokens for the active model route.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_tokens",
        "context_used",
        "context_limit"
      ]
    },
    "SessionDetail": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "user_id": {
          "description": "Owning SaaS user ID (`None` for legacy/system sessions).",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "doc_id": {
          "description": "Quire report bound to this session. `None` until the first run auto-binds.",
          "type": [
            "string",
            "null"
          ]
        },
        "linked_doc_id": {
          "description": "Frontend-friendly alias of the bound report ID.",
          "type": [
            "string",
            "null"
          ]
        },
        "kb_branch": {
          "description": "Knowledge-base branch used by this session. `None` only for sessions created before\nbranch-scoped knowledge bases existed; those fall back to the current active branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/SessionStatus"
        },
        "active_run_status": {
          "$ref": "#/$defs/ActiveRunStatus"
        },
        "last_event_seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "context_usage": {
          "$ref": "#/$defs/ContextUsage",
          "default": {
            "input_tokens": 0,
            "output_tokens": 0,
            "cached_tokens": 0,
            "context_used": 0,
            "context_limit": 0
          }
        },
        "compacting": {
          "type": "boolean",
          "default": false
        },
        "compacted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "pinned_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionMessage"
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachmentMeta"
          }
        },
        "pending_question": {
          "description": "Latest unresolved question card, restored after refresh or reconnect.",
          "anyOf": [
            {
              "$ref": "#/$defs/PendingQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_questions": {
          "description": "Answered, skipped and dismissed question cards in creation order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedQuestion"
          }
        },
        "pending_queue": {
          "description": "Messages waiting for the current run to finish, in FIFO order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingQueueItem"
          }
        },
        "active_run_trace": {
          "description": "Aggregated trace of the active run, captured at `last_event_seq`.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunTraceSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_subagent_traces": {
          "description": "Subagents embedded in the active run, with their streaming clocks.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunTraceSubagent"
          }
        }
      },
      "required": [
        "session_id",
        "title",
        "status",
        "active_run_status",
        "last_event_seq",
        "created_at",
        "updated_at"
      ]
