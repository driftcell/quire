# Copy to .env and adjust for your machine.
DATABASE_URL=postgres://report:report@127.0.0.1:5432/report_core
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=info,quire_server=debug,quire_store=debug
BIND_ADDR=0.0.0.0:8080
QUIRE_RW_TOKEN=dev-rw-token-change-me
QUIRE_RO_TOKEN=dev-ro-token-change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
AUTO_MIGRATE=true
MCP_JSON_RESPONSE=true
QUIRE_WORKSPACE_DIR=.
RUNTIME_BIND_ADDR=127.0.0.1:8081
RUNTIME_API_TOKEN=dev-runtime-token-change-me
RUNTIME_MASTER_KEY=dev-runtime-master-key-change-me
QUIRE_BASE_URL=http://127.0.0.1:8080
RUNTIME_MODEL=stub/echo
RUNTIME_MODEL_PROVIDER=mock
MODELS_DEV_URL=https://models.dev/api.json
RUNTIME_SSE_REPLAY_LIMIT=500
RUNTIME_PREVIEW_THROTTLE_MS=65
# Playwright MCP for the preview_report tool. The runtime posts JSON-RPC to
# <PLAYWRIGHT_MCP_URL>/mcp, so do not append /mcp here. The compose `playwright`
# service publishes this port on the host.
PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931
PLAYWRIGHT_MCP_PORT=8931
# Must be reachable from the Playwright browser inside the container.
PREVIEW_BASE_URL=http://host.docker.internal:5173
# URL returned to the user; open it in the host browser.
PREVIEW_PUBLIC_URL=http://localhost:5173
# Optional agent sandbox. Disabled by default; `local` is an explicit stub for tests.
SANDBOX_PROVIDER=disabled
# For Alibaba Cloud FC Agent Sandbox, set SANDBOX_PROVIDER=fc and provide the data-plane key.
# SANDBOX_FC_API_KEY=
SANDBOX_FC_REGION=cn-hangzhou
SANDBOX_FC_TEMPLATE=code-interpreter-v1
SANDBOX_TIMEOUT_SECONDS=300
# Optional endpoint overrides (derived from SANDBOX_FC_REGION by default):
# SANDBOX_FC_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
# SANDBOX_FC_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
RUNTIME_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]
SSE_HEARTBEAT_SECS=15
